generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// MODULE 1: USERS & MULTI-TENANCY
// ============================================

model Store {
  id               String   @id @default(uuid())
  storeOwnerUserId String?  @map("store_owner_user_id")
  storeName        String   @map("store_name")
  storeAddress     String?  @map("store_address")
  licenseNumber    String?  @map("license_number")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  owner          User?               @relation("StoreOwner", fields: [storeOwnerUserId], references: [id])
  subscription   Subscription?

  members        StoreMember[]
  categories     Category[]
  medicines      Medicine[]
  batches        InventoryBatch[]
  suppliers      Supplier[]
  purchaseOrders PurchaseOrder[]
  invoices       Invoice[]
  priceHistory   PriceHistory[]
  dailySales     DailySales[]
  activityLogs   ActivityLog[]

  @@map("stores")
}

// ============================================
// MODULE 0: SUBSCRIPTIONS
// ============================================

model SubscriptionPlan {
  id             String   @id @default(uuid())
  name           String   @unique
  price          Decimal  @db.Decimal(10, 2)
  durationMonths Int      @default(1)
  maxMedicines   Int      @default(100)
  maxUsers       Int      @default(3)
  features       Json?
  razorpayPlanId String?  @map("razorpay_plan_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("subscription_plans")
}

model Subscription {
  id                     String   @id @default(uuid())
  storeId                String   @unique @map("store_id")
  planId                 String   @map("plan_id")
  startDate              DateTime @default(now()) @map("start_date")
  endDate                DateTime @map("end_date")
  status                 String   @default("active") // active, expired, canceled, trialing
  paymentReference       String?  @map("payment_reference")
  razorpaySubscriptionId String?  @unique @map("razorpay_subscription_id")
  razorpayCustomerId     String?  @map("razorpay_customer_id")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  store Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan  SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

model Role {
  id       String        @id @default(uuid())
  roleName String        @unique @map("role_name")
  members  StoreMember[]

  @@map("roles")
}

model User {
  id           String    @id @default(uuid())
  supabaseId   String?   @unique @map("supabase_id")
  fullName     String    @map("full_name")
  address      String?
  email        String    @unique
  dateOfBirth  DateTime? @map("date_of_birth") @db.Date
  mobileNumber String?   @map("mobile_number")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  ownedStores      Store[]         @relation("StoreOwner")
  storeMemberships StoreMember[]
  purchaseOrders   PurchaseOrder[]
  invoices         Invoice[]
  priceChanges     PriceHistory[]
  activityLogs     ActivityLog[]

  @@map("users")
}

model StoreMember {
  id               String   @id @default(uuid())
  storeId          String   @map("store_id")
  userId           String   @map("user_id")
  roleId           String?  @map("role_id")
  invitationStatus String   @default("accepted") @map("invitation_status")
  invitedAt        DateTime @default(now()) @map("invited_at")

  store Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role  Role?  @relation(fields: [roleId], references: [id])

  @@unique([storeId, userId])
  @@map("store_members")
}

// ============================================
// MODULE 2: INVENTORY & MEDICINES
// ============================================

model Category {
  id      String @id @default(uuid())
  storeId String @map("store_id")
  name    String

  store     Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  medicines Medicine[]

  @@index([storeId, name])
  @@map("categories")
}

model Medicine {
  id           String  @id @default(uuid())
  name         String
  storeId      String  @map("store_id")
  categoryId   String? @map("category_id")
  genericName  String? @map("generic_name")
  sku          String?
  description  String?
  dosageForm   String? @map("dosage_form")
  reorderLevel Int     @default(10) @map("reorder_level")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  store        Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category     Category?           @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  batches      InventoryBatch[]
  poItems      PurchaseOrderItem[]
  priceHistory PriceHistory[]
  dailySales   DailySales[]

  @@index([storeId, name])
  @@index([storeId, genericName])
  @@map("medicines")
}

model InventoryBatch {
  id            String   @id @default(uuid())
  storeId       String   @map("store_id")
  medicineId    String   @map("medicine_id")
  batchNumber   String   @map("batch_number")
  quantity      Int      @default(0)
  expiryDate    DateTime @map("expiry_date")
  purchasePrice Decimal  @map("purchase_price") @db.Decimal(12, 2)
  sellingPrice  Decimal  @map("selling_price") @db.Decimal(12, 2)
  receivedDate  DateTime @default(now()) @map("received_date")
  supplierId    String?  @map("supplier_id")
  status        String   @default("active")

  store        Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  medicine     Medicine      @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  supplier     Supplier?     @relation(fields: [supplierId], references: [id])
  invoiceItems InvoiceItem[]

  @@index([storeId, medicineId])
  @@index([storeId, expiryDate])
  @@index([storeId, batchNumber])
  @@map("inventory_batches")
}

// ============================================
// MODULE 3: SUPPLY CHAIN & PROCUREMENT
// ============================================

model Supplier {
  id            String  @id @default(uuid())
  storeId       String  @map("store_id")
  supplierName  String  @map("supplier_name")
  contactPerson String? @map("contact_person")
  phone         String?
  email         String?
  address       String?
  tinNumber     String? @map("tin_number")
  isActive      Boolean @default(true) @map("is_active")

  store          Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  batches        InventoryBatch[]
  purchaseOrders PurchaseOrder[]

  @@index([storeId, supplierName])
  @@map("suppliers")
}

model PurchaseOrder {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  supplierId  String?  @map("supplier_id")
  userId      String?  @map("user_id")
  orderDate   DateTime @default(now()) @map("order_date")
  status      String   @default("draft")
  totalAmount Decimal  @default(0) @map("total_amount") @db.Decimal(15, 2)
  notes       String?

  store    Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier Supplier?           @relation(fields: [supplierId], references: [id])
  user     User?               @relation(fields: [userId], references: [id])
  items    PurchaseOrderItem[]

  @@index([storeId, orderDate])
  @@index([storeId, status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid())
  poId            String  @map("po_id")
  medicineId      String  @map("medicine_id")
  quantityOrdered Int     @map("quantity_ordered")
  unitCost        Decimal @map("unit_cost") @db.Decimal(12, 2)

  purchaseOrder PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  medicine      Medicine      @relation(fields: [medicineId], references: [id])

  @@map("purchase_order_items")
}

// ============================================
// MODULE 4: SALES & INVOICING
// ============================================

model Invoice {
  id            String   @id @default(uuid())
  storeId       String   @map("store_id")
  userId        String?  @map("user_id")
  invoiceNumber String   @unique @map("invoice_number")
  totalAmount   Decimal  @default(0) @map("total_amount") @db.Decimal(15, 2)
  paymentMethod String?  @map("payment_method")
  customerName  String?  @map("customer_name")
  customerPhone String?  @map("customer_phone")
  notes         String?
  createdAt     DateTime @default(now()) @map("created_at")

  store Store         @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User?         @relation(fields: [userId], references: [id])
  items InvoiceItem[]

  @@index([storeId, createdAt])
  @@index([storeId, invoiceNumber])
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(uuid())
  invoiceId String  @map("invoice_id")
  batchId   String  @map("batch_id")
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)
  subtotal  Decimal @db.Decimal(12, 2)

  invoice Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  batch   InventoryBatch @relation(fields: [batchId], references: [id])

  @@map("invoice_items")
}

// ============================================
// MODULE 5: LOGS & ANALYTICS
// ============================================

model PriceHistory {
  id               String   @id @default(uuid())
  storeId          String   @map("store_id")
  medicineId       String   @map("medicine_id")
  oldPurchasePrice Decimal? @map("old_purchase_price") @db.Decimal(12, 2)
  newPurchasePrice Decimal? @map("new_purchase_price") @db.Decimal(12, 2)
  oldSellingPrice  Decimal? @map("old_selling_price") @db.Decimal(12, 2)
  newSellingPrice  Decimal? @map("new_selling_price") @db.Decimal(12, 2)
  changedByUserId  String?  @map("changed_by_user_id")
  reason           String?
  changedAt        DateTime @default(now()) @map("changed_at")

  store    Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [changedByUserId], references: [id])

  @@index([storeId, medicineId])
  @@index([storeId, changedAt])
  @@map("price_history")
}

model DailySales {
  id                   String   @id @default(uuid())
  storeId              String   @map("store_id")
  reportDate           DateTime @map("report_date") @db.Date
  totalSalesCount      Int      @default(0) @map("total_sales_count")
  totalRevenue         Decimal  @default(0) @map("total_revenue") @db.Decimal(15, 2)
  totalProfit          Decimal  @default(0) @map("total_profit") @db.Decimal(15, 2)
  topSellingMedicineId String?  @map("top_selling_medicine_id")

  store              Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  topSellingMedicine Medicine? @relation(fields: [topSellingMedicineId], references: [id])

  @@unique([storeId, reportDate])
  @@map("daily_sales")
}

model ActivityLog {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  userId      String?  @map("user_id")
  action      String
  details     Json?
  performedAt DateTime @default(now()) @map("performed_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id])

  @@index([storeId, performedAt])
  @@index([storeId, action])
  @@map("activity_logs")
}